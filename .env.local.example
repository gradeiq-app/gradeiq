# ─────────────────────────────────────────────────────────────
# RawIQ — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# eBay Finding API
# Get your App ID (Client ID) from https://developer.ebay.com/my/keys
# Use the "Production" key, not the sandbox key.
# The Finding API uses your App ID directly — no OAuth needed for read-only searches.
EBAY_API_KEY=your_ebay_app_id_here

# Supabase
# Found in your Supabase project at: Settings → API
# The URL is the project URL (e.g. https://xxxx.supabase.co)
# The anon key is safe to expose in the browser — row-level security protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (server-side only — never expose to browser)
# Found in your Supabase project at: Settings → API → service_role key
# Required for the Stripe webhook to update user profiles (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────
# Stripe Billing (optional — app works without these)
# Create your account at https://stripe.com
# Keys are found in the Stripe Dashboard → Developers → API keys
# ─────────────────────────────────────────────────────────────

# Secret key — server-side only, never expose to browser
# Test: sk_test_...   Production: sk_live_...
STRIPE_SECRET_KEY=sk_placeholder_not_configured

# Publishable key — safe for the browser (not yet used, reserved for future Stripe.js)
# Test: pk_test_...   Production: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_placeholder_not_configured

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Use `stripe listen --forward-to localhost:3000/api/stripe/webhook` for local dev
STRIPE_WEBHOOK_SECRET=whsec_placeholder_not_configured

# Price IDs for your subscription products
# Create products in Stripe Dashboard → Products:
#   Pro plan:    $9/month recurring
#   Dealer plan: $29/month recurring
# Then copy the Price ID (starts with price_...)
STRIPE_PRO_PRICE_ID=price_placeholder_pro
STRIPE_DEALER_PRICE_ID=price_placeholder_dealer

# ─────────────────────────────────────────────────────────────
# Vercel Cron Security
# A random secret that protects the /api/admin/sets-discovery
# endpoint so only Vercel's cron scheduler can call it via POST.
# Generate one with: openssl rand -hex 32
# Add this same value to Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=your_random_cron_secret_here

# ─────────────────────────────────────────────────────────────
# Anthropic (Claude Vision API — Parallel Verifier)
# Get your API key from https://console.anthropic.com/settings/keys
# Required for the AI-powered parallel photo comparison feature.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Maximum upload size for the parallel verifier photo (bytes).
# Default: 10 MB. Lower for faster mobile uploads.
NEXT_PUBLIC_MAX_VERIFY_FILE_SIZE=10485760
