# ─────────────────────────────────────────────────────────────
# GradeIQ — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# eBay Finding API
# Get your App ID (Client ID) from https://developer.ebay.com/my/keys
# Use the "Production" key, not the sandbox key.
# The Finding API uses your App ID directly — no OAuth needed for read-only searches.
EBAY_API_KEY=your_ebay_app_id_here

# Supabase
# Found in your Supabase project at: Settings → API
# The URL is the project URL (e.g. https://xxxx.supabase.co)
# The anon key is safe to expose in the browser — row-level security protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
